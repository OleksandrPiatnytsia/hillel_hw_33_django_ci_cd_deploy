# Copy to .env and fill in real values: cp .env.example .env
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep the key in SINGLE quotes: it may contain "$". docker compose reads
# this file too and treats $abc as a variable (replaced with an empty string,
# "WARN The "abc" variable is not set"), so the web container would get a
# different, cut key. Inside single quotes compose substitutes nothing;
# python-dotenv also reads them literally and drops the quotes.
# Not double quotes: compose substitutes variables inside them too.
# The same applies to any value with "$", e.g. POSTGRES_PASSWORD.
DJANGO_SECRET_KEY='change-me'
# Read only by the development settings (runserver, manage.py on your
# machine); the production settings (Docker, Railway) always have DEBUG off.
DJANGO_DEBUG=True
# Host names of the site, comma separated. Required by the production settings.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production settings only (config/settings/production.py):
# HTTPS redirect, secure cookies, HSTS. docker-compose.yml sets False
# (http://localhost has no certificate); on a hosting leave it out (= True).
# DJANGO_HTTPS=True
# How long browsers keep to HTTPS only (seconds); 1 hour by default,
# a year (31536000) once the site works over HTTPS.
# DJANGO_HSTS_SECONDS=3600
# Other origins allowed to send forms (a second domain in front of the site)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com

# PostgreSQL. The postgres container creates this database and user on its
# first start (empty volume); Django connects with the same values.
# On a hosting one variable instead of these five (it wins when set):
# DATABASE_URL=postgresql://user:password@host:5432/name
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me
# localhost: Django on your machine (runserver, tests) -> port of the db container.
# docker-compose.yml overrides it with "db" for the web container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis server. Database 0: cache + sessions, database 1: the Celery queue
# (background tasks); the settings pick the numbers themselves.
# docker-compose.yml overrides the host with "redis".
REDIS_URL=redis://localhost:6379
# Only to put the Celery queue on another server (empty = REDIS_URL, database 1)
# CELERY_BROKER_URL=

# Email through Gmail SMTP (orders: "order created", "payment received").
# Empty -> emails are printed to the console instead of being sent.
# EMAIL_HOST_PASSWORD: an App Password (Google account -> Security ->
# 2-Step Verification -> App passwords), not the account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Address of the site for links in emails
SITE_URL=http://localhost:8000

# CORS: frontends on other domains that may call /api/ from a browser
# (comma separated, with the scheme and the port, no "/" at the end).
# Empty -> no other domain may (curl, Postman and servers still can).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe, test mode: Dashboard -> Developers -> API keys -> Secret key (sk_test_...)
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...), printed by the Stripe CLI service:
#   docker compose run --rm stripe-cli listen --print-secret
STRIPE_WEBHOOK_SECRET=

# Flower (Celery dashboard, http://localhost:5555): login and password,
# "user:password". Required by docker-compose.yml: Flower can also stop
# tasks and workers, it must not be open. No "," in the password: Flower
# reads "," as a separator between several user:password pairs.
FLOWER_BASIC_AUTH='admin:change-me'
# Link "Flower" in the profile of a superuser
FLOWER_URL=http://localhost:5555

# Sentry (sentry.io -> Projects -> Create Project -> Django), error tracking.
# The DSN: Settings -> Projects -> <project> -> Client Keys (DSN).
# Empty -> Sentry is off. docker-compose.yml sets SENTRY_ENVIRONMENT=docker.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Link "Sentry" in the profile of a superuser: the Issues page of the project
# (open it in Sentry and copy the address). Empty -> no link.
SENTRY_ISSUES_URL=
# Part of the requests timed in Sentry -> Performance (0.1 = every tenth, 0 = off)
SENTRY_TRACES_SAMPLE_RATE=0.1
