# Coverage settings, used by pytest --cov (pytest.ini).
# Only our own code counts: no virtual environment, no tests, no migrations
# (generated by Django), no settings and entry points (run once at start).

[run]
source = .
omit =
    .venv/*
    tests/*
    */migrations/*
    manage.py
    config/settings/*
    config/asgi.py
    config/wsgi.py

[report]
# Lines that can't run in tests by design
exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
    # A script started from the command line (.github/scripts/); the tests
    # call its main() directly
    if __name__ == .__main__.:

[html]
# pytest --cov-report=html -> htmlcov/index.html (in .gitignore)
directory = htmlcov
