# flake8: errors and style problems black doesn't fix (unused imports and
# variables, undefined names, too long strings and comments, ...).
# Run: flake8   (CI runs it too and fails on any finding)
# flake8 can't read pyproject.toml, so its settings live here.

[flake8]
# The same limit as black (pyproject.toml, line-length)
max-line-length = 100

# Rules that argue with black (black's own advice, "Using Black with other
# tools"):
#   E203 whitespace before ":" - black writes ham[lower + offset :]
#   E701, E704 several statements on one line - black keeps "def f(): ..."
#     (stubs, protocols) on one line
# extend-ignore, not ignore: flake8's own default list (W503, W504, ...)
# stays ignored too.
extend-ignore = E203, E701, E704

# Not our code or not code at all. The default list (.git, __pycache__, ...)
# is replaced by this one, so it is repeated here.
exclude =
    .git,
    __pycache__,
    .venv,
    htmlcov,
    staticfiles,
    media,
    logs,
    locale

# Generated by Django (makemigrations): long lines in the operations are
# not worth fixing by hand; black still formats them.
per-file-ignores =
    */migrations/*.py: E501
